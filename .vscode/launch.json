{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Flask (launch)",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "main.py",
        "FLASK_ENV": "development"
      },
      "args": ["run", "--no-debugger", "--no-reload", "--host=0.0.0.0"],
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "Python: Attach (Remote)",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      }
    }
  ]
}
