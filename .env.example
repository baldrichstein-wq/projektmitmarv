# Kopieren nach ".env" und mit echten, geheimen Werten fuellen.
# ".env" NIEMALS committen (ist in .gitignore ausgeschlossen).

# Flask
SECRET_KEY=change-me-generate-with-python-c-import-secrets-print-secrets.token_hex(32)
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true

# Kommagetrennte Liste der erlaubten Frontend-Origins (Produktion: echte Domain(s) eintragen)
CORS_ORIGINS=https://your-frontend-domain.example

# PostgreSQL
POSTGRES_DB=benutzerdb
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# MongoDB
MONGO_USER=change-me
MONGO_PASSWORD=change-me
