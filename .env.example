# Kopieren nach ".env" und mit echten, geheimen Werten fuellen.
# ".env" NIEMALS committen (ist in .gitignore ausgeschlossen).

# Flask
SECRET_KEY=change-me-generate-with-python-c-import-secrets-print-secrets.token_hex(32)
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true

# Kommagetrennte Liste der erlaubten Frontend-Origins (Produktion: echte Domain(s) eintragen)
CORS_ORIGINS=https://your-frontend-domain.example

# NEU 07.08.2026 (Stefan): Domain fuer den Caddy-Reverse-Proxy (automatisches HTTPS via
# Let's Encrypt, siehe Caddyfile). Ohne echte Domain faellt Caddy auf ein selbstsigniertes
# "localhost"-Zertifikat zurueck (nur fuer lokale Tests).
DOMAIN=your-domain.example

# NEU 07.08.2026 (Stefan): Anzahl Gunicorn-Worker im Backend-Container. Default 2, passend
# fuer kleine Instanzen (z.B. AWS t3.micro, 1 GiB RAM); auf leistungsfaehigerer Hardware
# (z.B. NAS) kann der Wert erhoeht werden.
WEB_CONCURRENCY=2

# PostgreSQL
POSTGRES_DB=benutzerdb
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# MongoDB
MONGO_USER=change-me
MONGO_PASSWORD=change-me
