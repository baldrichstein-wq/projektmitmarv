# Datenbankverbindung
# SQLite (Standard):
DATABASE_URL=sqlite:///rezeptbuch.db
# PostgreSQL (auskommentieren und anpassen):
# DATABASE_URL=postgresql://benutzer:passwort@localhost:5432/rezeptbuch

# Sicherheitsschlüssel (unbedingt mit sicheren Zufallswerten ersetzen!)
SECRET_KEY=dein-geheimer-schluessel-hier
JWT_SECRET_KEY=dein-jwt-schluessel-hier

# Flask-Umgebung: development | testing | production
FLASK_ENV=development
